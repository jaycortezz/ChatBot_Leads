# Google Places API (New/Legacy Text Search) - https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# Hunter.io free-tier API key - https://hunter.io/api-keys
HUNTER_API_KEY=

# Google Sheets output
# 1. Create a Google Cloud service account, download its JSON key, save it as
#    service_account.json in the project root (already gitignored).
# 2. Share your target Google Sheet with the service account's client_email
#    (found inside service_account.json) as an Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=
